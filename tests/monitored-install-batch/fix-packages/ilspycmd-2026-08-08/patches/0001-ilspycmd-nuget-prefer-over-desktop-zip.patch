+/** True when the package id has at least one version on the NuGet flat container. */
+export async function nugetPackageExists(
+  packageName: string,
+): Promise<boolean> {
+  if (!packageName || !String(packageName).trim()) return false;
+  try {
+    const data = await fetchNugetData(packageName);
+    return Boolean(data?.version);
+  } catch {
+    return false;
+  }
+}
+
 async function fetchNugetData(packageName: string) {
   const base = process.env.NUGET_FLAT_URL || process.env.NUGET_URL || "https://api.nuget.org";
   const url = `${base}/v3-flatcontainer/${encodeURIComponent(packageName.toLowerCase())}/index.json`;
