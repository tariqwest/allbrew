+/** NuGet package ids referenced via nuget.org/packages/<id> links in docs. */
+export function extractNugetPackageIds(readmeText: string): string[] {
+  if (!readmeText) return [];
+  const ids: string[] = [];
+  const re = /nuget\.org\/packages\/([A-Za-z0-9._-]+)/gi;
+  let match: RegExpExecArray | null;
+  while ((match = re.exec(readmeText)) !== null) {
+    const id = String(match[1] || "").trim();
+    if (id) ids.push(id);
+  }
+  return [...new Set(ids)];
+}
+
+/**
+ * Prefer a NuGet package id that matches the caller's preferred name when the
+ * README only links to nuget.org (no `dotnet tool install` shell line).
+ */
+export function pickPreferredNugetPackage(
+  readmeText: string,
+  preferredPackageName = "",
+): string | null {
+  const ids = extractNugetPackageIds(readmeText);
+  if (ids.length === 0) return null;
+  const preferred = String(preferredPackageName || "")
+    .trim()
+    .toLowerCase();
+  if (!preferred) return null;
+  const preferredLast = preferred.split("/").pop() || preferred;
+  const hit = ids.find((id) => {
+    const lower = id.toLowerCase();
+    return lower === preferred || lower === preferredLast;
+  });
+  return hit || null;
+}
