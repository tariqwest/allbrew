+describe("NuGet package link detection", () => {
+  it("extracts package ids from nuget.org links and prefers matching name", () => {
+    const readme = `
+* Our dotnet tool - [dotnet tool install](https://www.nuget.org/packages/ilspycmd/)
+* Library: https://www.nuget.org/packages/ICSharpCode.Decompiler/
+`;
+    expect(extractNugetPackageIds(readme).sort()).toEqual(
+      ["ICSharpCode.Decompiler", "ilspycmd"].sort(),
+    );
+    expect(pickPreferredNugetPackage(readme, "ilspycmd")).toBe("ilspycmd");
+    expect(pickPreferredNugetPackage(readme, "ILSpy")).toBeNull();
+    expect(detectInstallMethod(readme, "ilspycmd")).toEqual({
+      method: "dotnet",
+      package: "ilspycmd",
+    });
+  });
+
+  it("detects shell `dotnet tool install -g` commands", () => {
+    const readme = "```bash\ndotnet tool install -g csharprepl\n```";
+    expect(detectInstallMethod(readme)).toEqual({
+      method: "dotnet",
+      package: "csharprepl",
+    });
+  });
+});
