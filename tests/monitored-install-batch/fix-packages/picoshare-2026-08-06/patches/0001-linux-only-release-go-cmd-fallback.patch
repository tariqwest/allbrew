+/** True for darwin/macos/universal binary-release arch keys. */
+export function isMacosBinaryArch(arch: string | null | undefined): boolean {
+  return (
+    arch === "macosArm" ||
+    arch === "macosIntel" ||
+    arch === "macosUniversal"
+  );
+}
+
+/** True for linux binary-release arch keys. */
+export function isLinuxBinaryArch(arch: string | null | undefined): boolean {
+  return arch === "linuxArm" || arch === "linuxIntel";
+}
+
+/**
+ * Whether any of the named release assets are installable via binary-release
+ * on the given host platform. Linux-only release tarballs are not installable
+ * on macOS Homebrew, so routing should fall through to source/registry builds.
+ */
+export function hasHostInstallableBinaryAssets(
+  assetNames: string[],
+  platform: string = process.platform,
+): boolean {
+  if (!assetNames?.length) return false;
+  const arches = assetNames
+    .map((n) => matchAssetToArch(n))
+    .filter((a): a is string => Boolean(a));
+  if (platform === "darwin") return arches.some((a) => isMacosBinaryArch(a));
+  if (platform === "linux") return arches.some((a) => isLinuxBinaryArch(a));
+  return arches.some((a) => isMacosBinaryArch(a) || isLinuxBinaryArch(a));
+}
+
 export function isAppAsset(assetName) {
