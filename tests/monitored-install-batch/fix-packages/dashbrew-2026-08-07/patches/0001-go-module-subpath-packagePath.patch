+/** Strip `@version` and split go install targets into module + package path.
+ * Handles:
+ * - `github.com/owner/repo/cmd/foo@latest` → module github.com/owner/repo, path ./cmd/foo
+ * - `./cmd/foo` → module from repo, path ./cmd/foo
+ * - `github.com/owner/repo` → module only
+ */
+export function resolveGoInstallTarget(
+  raw: string | null | undefined,
+  repoInfo: any = null,
+): { goModule: string; packagePath: string } {
+  let spec = String(raw || "").trim();
+  if (!spec) {
+    return {
+      goModule: repoInfo?.fullName ? `github.com/${repoInfo.fullName}` : "",
+      packagePath: "",
+    };
+  }
+
+  const at = spec.lastIndexOf("@");
+  if (at > 0 && !spec.slice(at + 1).includes("/")) {
+    spec = spec.slice(0, at);
+  }
+
+  const isRelative = spec.startsWith("./") || spec.startsWith("../");
+  if (isRelative) {
+    return {
+      goModule: repoInfo?.fullName ? `github.com/${repoInfo.fullName}` : "",
+      packagePath: spec,
+    };
+  }
+
+  // github.com/owner/repo[/subpath...]
+  const gh = spec.match(/^(github\.com\/[^/]+\/[^/]+)(\/.+)?$/);
+  if (gh) {
+    const mod = gh[1];
+    const sub = gh[2] || "";
+    return {
+      goModule: mod,
+      packagePath: sub ? `.${sub}` : "",
+    };
+  }
+
+  return { goModule: spec, packagePath: "" };
+}
