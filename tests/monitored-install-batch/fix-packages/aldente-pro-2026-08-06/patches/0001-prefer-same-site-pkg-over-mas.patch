+describe("rankCandidatesForPage / mac pkg vs MAS", () => {
+  it("tokenizes package name hints", () => {
+    expect(nameHintTokens("aldente-pro")).toEqual(["aldente", "pro"]);
+  });
+
+  it("scores same-site .pkg above unrelated MAS listing", () => {
+    const page = "https://apphousekitchen.com";
+    const list = rankCandidatesForPage(
+      [
+        scoreCandidateUrl(
+          "https://apps.apple.com/us/app/leftovers-folder-organizer/id6746164364?mt=12",
+          page,
+          ["html-attr"],
+        ),
+        scoreCandidateUrl(
+          "https://apphousekitchen.com/aldente/AlDente.pkg",
+          page,
+          ["html-attr"],
+        ),
+      ],
+      page,
+      "aldente-pro",
+    );
+    expect(list[0].url).toContain("AlDente.pkg");
+    expect(list[0].score).toBeGreaterThan(list[1].score);
+    const chosen = pickAutoCandidate(list);
+    expect(chosen?.url).toContain("AlDente.pkg");
+  });
+
+  it("pathLooksMac / pkg scoring treats pkg as installer", () => {
+    const page = "https://apphousekitchen.com";
+    const pkg = scoreCandidateUrl(
+      "https://apphousekitchen.com/aldente/AlDente.pkg",
+      page,
+      ["html-attr"],
+    );
+    expect(pkg.score).toBeGreaterThanOrEqual(100);
+    expect(pkg.evidence.some((e) => e.includes("mac-pkg") || e === "mac-hint")).toBe(true);
+  });
+});
