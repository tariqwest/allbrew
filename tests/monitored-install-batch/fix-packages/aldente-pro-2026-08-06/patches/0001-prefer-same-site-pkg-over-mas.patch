+/** Tokenize a formula/cask name for path matching (aldente-pro → aldente, pro). */
+export function nameHintTokens(name: string | undefined | null): string[] {
+  if (!name) return [];
+  return String(name)
+    .toLowerCase()
+    .split(/[^a-z0-9]+/i)
+    .filter((t) => t.length >= 3);
+}
+
+function isDirectMacInstaller(c: DiscoverCandidate): boolean {
+  return (
+    c.kind === "cask-dmg" ||
+    /\.(?:dmg|pkg)(?:\?|#|$)/i.test(c.url)
+  );
+}
+
+function isStorefrontCandidate(c: DiscoverCandidate): boolean {
+  return (
+    c.kind === "mac-app-store" ||
+    c.kind === "setapp-app" ||
+    /apps\.apple\.com|itunes\.apple\.com|setapp\.com/i.test(c.url)
+  );
+}
+
+/**
+ * Prefer same-site (or any) direct .dmg/.pkg over Mac App Store / Setapp when both
+ * appear on multi-product marketing pages. Optionally boost path tokens matching
+ * the user-requested package name.
+ */
+export function rankCandidatesForPage(
+  candidates: DiscoverCandidate[],
+  pageUrl: string,
+  preferredName?: string | null,
+): DiscoverCandidate[] {
+  if (!candidates.length) return candidates;
+  const hasDirect = candidates.some(isDirectMacInstaller);
+  const tokens = nameHintTokens(preferredName);
+  const ranked = candidates.map((c) => {
+    let score = c.score;
+    const evidence = [...c.evidence];
+    if (hasDirect && isStorefrontCandidate(c) && !isDirectMacInstaller(c)) {
+      score -= 40;
+      evidence.push("storefront-demote-vs-direct");
+    }
+    if (tokens.length) {
+      try {
+        const path = new URL(c.url).pathname.toLowerCase();
+        const hay = `${path} ${c.url.toLowerCase()}`;
+        const hits = tokens.filter((t) => hay.includes(t));
+        if (hits.length) {
+          score += 10 + hits.length * 8;
+          evidence.push(`name-hint:${hits.join(",")}`);
+        } else if (isStorefrontCandidate(c)) {
+          // Unrelated store listing on a multi-product page
+          const storeSlug = path.replace(/[^a-z0-9]+/g, " ");
+          if (tokens.every((t) => !storeSlug.includes(t))) {
+            score -= 15;
+            evidence.push("name-hint-miss-storefront");
+          }
+        }
+      } catch {
+        /* ignore */
+      }
+    }
+    if (isDirectMacInstaller(c) && sameSite(c.url, pageUrl)) {
+      score += 8;
+      evidence.push("same-site-direct-installer");
+    }
+    return { ...c, score, evidence };
+  });
+  return ranked.sort((a, b) => b.score - a.score);
+}
+
