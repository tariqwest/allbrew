 function extractVersionFromUrl(url: string) {
+  // Ignore GitHub "/releases/latest/download/" — "latest" is not a version.
+  if (/\/releases\/latest\//i.test(url)) return null;
   const match = url.match(/[/-]v?(\d+\.\d+(?:\.\d+)?)/);
   return match ? match[1] : null;
 }
