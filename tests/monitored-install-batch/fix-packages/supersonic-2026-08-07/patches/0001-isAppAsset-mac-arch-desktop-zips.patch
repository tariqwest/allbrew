+/** Word.Word(.Word)*.tgz product names without platform/arch (macOS .app tarballs). */
+function isDottedProductAppArchive(lowerName: string): boolean {
+  if (
+    /(?:^|[^a-z])(?:linux|windows|win32|android|freebsd|openbsd)(?:[^a-z]|$)/i.test(
+      lowerName,
+    )
+  ) {
