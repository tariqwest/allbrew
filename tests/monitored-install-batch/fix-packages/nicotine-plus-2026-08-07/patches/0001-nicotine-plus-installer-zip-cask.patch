+    const archMatch = appAssets.find(
+      (a) => matchAssetToArch(a.name) === hostArch,
+    );
+    if (archMatch) return archMatch;
+  }
+  const universal = appAssets.find(
+    (a) => matchAssetToArch(a.name) === "macosUniversal",
+  );
