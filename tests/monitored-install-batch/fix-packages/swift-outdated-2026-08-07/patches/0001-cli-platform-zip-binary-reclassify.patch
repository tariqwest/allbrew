+/**
+ * Loose platform match for release archives that only tag OS (not CPU), e.g.
+ * `swift-outdated-0.15.3-macos.zip` / `…-linux.zip`. Used when reclassifying
+ * false-positive isAppAsset zips into binary-release formulas.
+ */
+export function matchLoosePlatformArch(assetName) {
+  const strict = matchAssetToArch(assetName);
+  if (strict) return strict;
+  const lower = String(assetName || "").toLowerCase();
+  if (!lower) return null;
+  if (/(?:^|[^a-z])(?:linux)(?:[^a-z]|$)/i.test(lower)) {
+    return "linuxIntel";
+  }
+  if (
+    /(?:^|[^a-z])(?:mac|macos|osx|darwin)(?:[^a-z]|$)/i.test(lower) &&
+    !/(?:^|[^a-z])(?:windows|win32|android)(?:[^a-z]|$)/i.test(lower)
+  ) {
+    return "macosUniversal";
+  }
+  return null;
+}
+
+/**
+ * Zip/tarball that isAppAsset() flags (macos token, no CPU arch) but is often a
+ * prebuilt CLI, not a .app — especially when the release also ships a linux zip.
+ */
+export function isReclassifiablePlatformCliZip(assetName) {
+  const lower = String(assetName || "").toLowerCase();
+  if (!lower.endsWith(".zip") && !lower.endsWith(".tar.gz") && !lower.endsWith(".tgz")) {
+    return false;
+  }
+  if (lower.includes(".app") || lower.includes("artifactbundle")) return false;
+  if (lower.endsWith(".dmg")) return false;
+  if (!isAppAsset(assetName) && matchAssetToArch(assetName) != null) return false;
+  // Must look like an app-misclassified mac zip OR an untagged platform archive
+  if (isAppAsset(assetName)) return true;
+  return matchLoosePlatformArch(assetName) != null && isArchiveBinaryAsset(assetName);
+}
+
