diff --git a/lib/generators/binary-release.ts b/lib/generators/binary-release.ts
index d6eb00f..372e4d3 100644
--- a/lib/generators/binary-release.ts
+++ b/lib/generators/binary-release.ts
@@ -8,6 +8,7 @@ import {
   isBinaryAsset,
   isBareBinaryAsset,
   isArchiveBinaryAsset,
+  isUntaggedMacBinaryAsset,
   rubyString,
   rubyEscape,
   guessLicenseIdentifier,
@@ -208,6 +209,24 @@ export async function collectBinaryReleasePayload(
     delete archAssets.macosUniversal;
   }
 
+  // Portable untagged CLI zips (e.g. license-plist.zip) — no arch in filename.
+  if (Object.keys(archAssets).length === 0) {
+    const untagged = release.assets.filter((a: any) =>
+      isUntaggedMacBinaryAsset(a.name),
+    );
+    if (untagged.length === 1) {
+      archAssets.macosArm = untagged[0];
+      archAssets.macosIntel = untagged[0];
+    } else if (untagged.length > 1) {
+      // Prefer the smaller/shorter-named zip (plain tool zip over fat bundles).
+      const ranked = [...untagged].sort(
+        (a, b) => a.name.length - b.name.length || a.name.localeCompare(b.name),
+      );
+      archAssets.macosArm = ranked[0];
+      archAssets.macosIntel = ranked[0];
+    }
+  }
+
   if (Object.keys(archAssets).length === 0) {
     throw new Error("No platform-specific binary assets found in release");
   }
