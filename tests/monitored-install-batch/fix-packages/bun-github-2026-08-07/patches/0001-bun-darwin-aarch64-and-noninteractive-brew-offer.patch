+/**
+ * Whether a release asset is a CLI binary installable on the current host OS/CPU.
+ * Used to decide auto binary-release vs fall through to source/go/cargo generators.
+ * (Formulas may still list multi-arch URLs; host must have at least one matching mac/linux block.)
+ */
+export function isHostCompatibleBinaryAsset(
+  assetName,
+  host: { platform?: string; arch?: string } = {},
+) {
+  const archKey = matchAssetToArch(assetName);
+  if (!archKey) return false;
+  const platform = host.platform ?? process.platform;
+  const cpu = host.arch ?? process.arch;
+  if (platform === "darwin") {
+    if (cpu === "arm64") {
+      return archKey === "macosArm" || archKey === "macosUniversal";
+    }
+    return archKey === "macosIntel" || archKey === "macosUniversal";
+  }
+  if (platform === "linux") {
+    if (cpu === "arm64") return archKey === "linuxArm";
+    return archKey === "linuxIntel";
+  }
+  return false;
+}
+
+/** True if any asset is a host-compatible CLI binary. */
+export function releaseHasHostCompatibleBinary(
+  assets: Array<{ name?: string } | string>,
+  host: { platform?: string; arch?: string } = {},
+) {
+  return assets.some((a) => {
+    const name = typeof a === "string" ? a : a?.name;
+    return name ? isHostCompatibleBinaryAsset(name, host) : false;
+  });
+}
