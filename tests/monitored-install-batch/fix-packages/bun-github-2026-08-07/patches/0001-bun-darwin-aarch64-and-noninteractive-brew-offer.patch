+    /(?:^|[^a-z])(?:arm64|aarch64|amd64|x86_64|x64|i386|darwin|macos|osx)(?:[^a-z]|$)/i.test(
+      lowerName,
+    )
+  ) {
+    return false;
+  }
+  const base = lowerName
+    .replace(/\.tar\.gz$/, "")
