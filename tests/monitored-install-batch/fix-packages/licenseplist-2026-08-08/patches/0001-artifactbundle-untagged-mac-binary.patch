+/**
+ * Untagged portable CLI zips (e.g. license-plist.zip) with no linux/windows
+ * token — treat as a macOS universal binary asset candidate for release routing.
+ */
+export function isUntaggedMacBinaryAsset(assetName) {
+  if (!isBinaryAsset(assetName)) return false;
+  if (matchAssetToArch(assetName) != null) return false;
+  const lower = assetName.toLowerCase();
+  if (/(?:^|[^a-z])(?:linux|windows|win32|android)(?:[^a-z]|$)/i.test(lower)) {
+    return false;
+  }
+  // Prefer archive-shaped assets for untagged portable CLIs
+  return isArchiveBinaryAsset(assetName) || isBareBinaryAsset(assetName);
+}
