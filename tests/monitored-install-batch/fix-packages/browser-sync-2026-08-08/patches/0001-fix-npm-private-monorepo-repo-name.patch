+describe("isNpmRegistryCandidate", () => {
+  it("rejects private package roots", () => {
+    expect(
+      isNpmRegistryCandidate({ name: "browser-sync-mono", private: true }),
+    ).toBe(false);
+  });
+
+  it("rejects workspaces without bin", () => {
+    expect(
+      isNpmRegistryCandidate({
+        name: "LibreChat",
+        workspaces: ["api", "client"],
+      }),
+    ).toBe(false);
+  });
+
+  it("allows publishable packages with bin", () => {
+    expect(
+      isNpmRegistryCandidate({ name: "browser-sync", bin: { "browser-sync": "dist/bin.js" } }),
+    ).toBe(true);
+  });
+
+  it("allows simple packages without workspaces", () => {
+    expect(isNpmRegistryCandidate({ name: "npkill" })).toBe(true);
+  });
+
+  it("treats null/empty as candidate (caller uses repo name)", () => {
+    expect(isNpmRegistryCandidate(null)).toBe(true);
+    expect(isNpmRegistryCandidate({})).toBe(true);
+  });
+});
