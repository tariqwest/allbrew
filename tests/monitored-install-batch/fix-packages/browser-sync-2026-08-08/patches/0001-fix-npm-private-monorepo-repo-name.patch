+/** True when root package.json is a plausible npm registry package.
+ * Private monorepo roots and workspace shells without bin are not.
+ * Callers may still try `repo.name` on the registry before source-build.
+ */
+export function isNpmRegistryCandidate(pkg: any): boolean {
+  if (!pkg || typeof pkg !== "object") return true;
+  if (pkg.private === true) return false;
+
+  const bin = pkg.bin;
+  const hasBin =
+    typeof bin === "string"
+      ? bin.length > 0
+      : bin && typeof bin === "object" && !Array.isArray(bin)
+        ? Object.keys(bin).length > 0
+        : false;
+
+  const ws = pkg.workspaces;
+  const hasWorkspaces = Array.isArray(ws)
+    ? ws.length > 0
+    : !!(ws && typeof ws === "object" && Array.isArray(ws.packages) && ws.packages.length > 0);
+
+  if (hasWorkspaces && !hasBin) return false;
+  return true;
+}
