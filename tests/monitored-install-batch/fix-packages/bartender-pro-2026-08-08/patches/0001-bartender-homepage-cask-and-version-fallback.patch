+function brandCoreLabel(label: string): string {
+  const l = String(label || "").toLowerCase();
+  if (!l) return "";
+  const stripped = l.replace(/^(get|try|use|go|download|www|app)/, "");
+  if (stripped.length >= 3) return stripped;
+  return l;
