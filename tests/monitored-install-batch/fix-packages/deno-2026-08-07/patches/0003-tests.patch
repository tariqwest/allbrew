+
+describe("scoreBinaryReleaseAsset (deno multi-asset releases)", () => {
+  it("prefers deno primary zip over denort and libdenort", async () => {
+    const { scoreBinaryReleaseAsset } = await import(
+      "../../../lib/generators/binary-release.ts"
+    );
+    const hints = ["deno"];
+    const primary = scoreBinaryReleaseAsset(
+      "deno-aarch64-apple-darwin.zip",
+      hints,
+    );
+    const denort = scoreBinaryReleaseAsset(
+      "denort-aarch64-apple-darwin.zip",
+      hints,
+    );
+    const lib = scoreBinaryReleaseAsset(
+      "libdenort-aarch64-apple-darwin.zip",
+      hints,
+    );
+    const delta = scoreBinaryReleaseAsset(
+      "deno-aarch64-apple-darwin.from-2.9.4.bsdiff",
+      hints,
+    );
+    expect(primary).toBeGreaterThan(denort);
+    expect(primary).toBeGreaterThan(lib);
+    expect(primary).toBeGreaterThan(delta);
+  });
+
+  it("collectBinaryReleasePayload selects deno-*.zip not libdenort", async () => {
+    const assets = [
+      {
+        name: "deno-aarch64-apple-darwin.from-2.9.4.bsdiff",
+        url: "https://example.com/bsdiff",
+      },
+      {
+        name: "deno-aarch64-apple-darwin.zip",
+        url: "https://example.com/deno-arm.zip",
+      },
+      {
+        name: "deno-x86_64-apple-darwin.zip",
+        url: "https://example.com/deno-x64.zip",
+      },
+      {
+        name: "denort-aarch64-apple-darwin.zip",
+        url: "https://example.com/denort.zip",
+      },
+      {
+        name: "libdenort-aarch64-apple-darwin.zip",
+        url: "https://example.com/libdenort.zip",
+      },
+      {
+        name: "libdenort-x86_64-apple-darwin.zip",
+        url: "https://example.com/libdenort-x64.zip",
+      },
+    ];
+    const repo = {
+      name: "deno",
+      description: "A modern runtime for JavaScript and TypeScript.",
+      license: "MIT",
+      homepage: "https://deno.com",
+      htmlUrl: "https://github.com/denoland/deno",
+    };
+    const payload = await collectBinaryReleasePayload(
+      repo,
+      { tagName: "v2.9.5", assets },
+      { name: "deno-tap", binName: "deno" },
+    );
+    // URLs are templated; asset selection is reflected in chosen download URLs.
+    expect(payload.platformBlocks).toContain("deno-arm.zip");
+    expect(payload.platformBlocks).toContain("deno-x64.zip");
+    expect(payload.platformBlocks).not.toContain("libdenort");
+    expect(payload.platformBlocks).not.toContain("denort");
+    expect(payload.binName).toBe("deno");
+  });
+});
