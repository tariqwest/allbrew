+  const pkg = String(packageName || "").toLowerCase();
+  const hasSystemdUnit = fileNames.some((f) => {
+    const lower = String(f || "").toLowerCase().replace(/\\/g, "/");
+    if (!lower.endsWith(".service")) return false;
+    // Prefer unit files under systemd paths or named after the package.
+    if (lower.includes("systemd") || lower.includes("/init/") || lower.includes("lib/systemd")) {
+      return true;
+    }
+    if (pkg && (lower.endsWith(`/${pkg}.service`) || lower.endsWith(`${pkg}.service`))) {
+      return true;
+    }
+    return false;
+  });
