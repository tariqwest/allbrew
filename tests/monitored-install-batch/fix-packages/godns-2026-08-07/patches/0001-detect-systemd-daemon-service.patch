+  // systemd unit management (systemctl enable/start <unit>) — common for Go
+  // daemons / DDNS clients shipped with a unit file (e.g. godns).
+  const systemctl = readmeText.match(
+    /systemctl\s+(?:enable|start|restart)\s+([a-zA-Z0-9._@-]+)/i,
+  );
+  if (systemctl) {
+    const unit = String(systemctl[1] || "")
+      .replace(/\.service$/i, "")
+      .trim();
+    const command = packageName || unit;
+    if (command) {
+      return {
+        command,
+        keepAlive: true,
+        confidence: "high",
+        reason: "README documents systemd/systemctl service management",
+      };
+    }
+  }
+
+  // Explicit "managed daemon" / "manual daemon" sections with nohup ./pkg or bare
+  // package binary — long-running process without serve/server subcommands.
+  const managedDaemon =
+    /\bas\s+a\s+(?:managed|manual)\s+daemon\b/i.test(readmeText) ||
+    /\b(?:copy|install)\b[^\n]{0,80}\.service\b/i.test(readmeText);
+  if (managedDaemon && packageName) {
+    return {
+      command: packageName,
+      keepAlive: true,
+      confidence: "high",
+      reason: "README documents running the package as a managed/manual daemon",
+    };
+  }
