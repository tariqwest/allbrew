+/**
+ * Seed stable vendor download endpoints for SPAs that hide DMG URLs behind JS.
+ * Prefer long-lived vendor URLs over short-lived signed CDN captures.
+ */
+export function seedVendorDownloadCandidates(pageUrl: string): DiscoverCandidate[] {
+  try {
+    const u = new URL(pageUrl);
+    const host = u.hostname.replace(/^www\./i, "").toLowerCase();
+    const out: DiscoverCandidate[] = [];
+    if (host === "raycast.com") {
+      // Official macOS download redirect (stable); resolve at install time via GET.
+      out.push({
+        url: "https://releases.raycast.com/download",
+        kind: "cask-dmg",
+        score: 160,
+        evidence: ["vendor-seed", "raycast-stable-download"],
+        source: "static",
+      });
+    }
+    return out;
+  } catch {
+    return [];
+  }
 }
 
+/** Prefer non-presigned candidates when scores are close. */
+export function demotePresignedCandidates(
+  candidates: DiscoverCandidate[],
+): DiscoverCandidate[] {
+  return candidates
+    .map((c) => {
+      if (/[?&]X-Amz-Signature=|[?&]X-Amz-Credential=/i.test(c.url)) {
+        return {
+          ...c,
+          score: Math.max(0, c.score - 50),
+          evidence: [...c.evidence, "presigned-url-penalty"],
+        };
+      }
+      return c;
+    })
+    .sort((a, b) => b.score - a.score);
+}
 
