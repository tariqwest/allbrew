+/**
+ * When a marketing homepage only links product or download index pages (no
+ * direct .dmg/.zip), fetch a few same-site hops and merge their candidates.
+ * Prefer paths that match preferredName (tokenized) and /download/ hubs.
+ */
+export async function enrichSameSiteProductPages(
+  candidates: DiscoverCandidate[],
+  pageUrl: string,
+  html: string,
+  opts: {
+    log?: (msg: string) => void;
+    preferredName?: string;
+    maxPages?: number;
+    fetchHtml?: (url: string) => Promise<{ body: string; url: string }>;
+  } = {},
+): Promise<DiscoverCandidate[]> {
+  const log = opts.log || (() => {});
+  const maxPages = opts.maxPages ?? 3;
+  if (pickAutoCandidate(candidates)) return candidates;
+
+  const strongArchive = candidates.some(
+    (c) =>
+      c.score >= 70 &&
+      (c.kind === "archive" ||
+        c.kind === "cask-dmg" ||
+        /\.(dmg|pkg|zip)(?:\?|#|$)/i.test(c.url)),
+  );
+  if (strongArchive) return candidates;
+
+  const preferred = String(opts.preferredName || "")
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, "");
+
+  type Hop = { url: string; score: number };
+  const hops = new Map<string, number>();
+
+  const consider = (raw: string, baseScore: number) => {
+    const abs = normalizeCandidateUrl(raw, pageUrl);
+    if (!abs) return;
+    if (!sameSite(abs, pageUrl)) return;
+    try {
+      const u = new URL(abs);
+      // Skip pure assets and the current page
+      if (u.href.replace(/\/$/, "") === new URL(pageUrl).href.replace(/\/$/, "")) return;
+      if (/\.(dmg|pkg|zip|tgz|tar\.gz)(?:\?|#|$)/i.test(u.pathname)) {
+        // already an artifact — extractCandidates would have it
+        return;
+      }
+      let score = baseScore;
+      const path = u.pathname.toLowerCase();
+      if (/\/download\b/.test(path)) score += 40;
+      if (/\/apps?\//.test(path)) score += 30;
+      if (preferred && path.replace(/[^a-z0-9]+/g, "").includes(preferred)) score += 50;
+      if (preferred && u.href.toLowerCase().replace(/[^a-z0-9]+/g, "").includes(preferred)) {
+        score += 20;
+      }
+      // Deprioritize blog/forum/support
+      if (/\/(blog|forum|support|faq|login|cart|pricing)\b/.test(path)) score -= 40;
+      const prev = hops.get(abs) ?? -Infinity;
+      if (score > prev) hops.set(abs, score);
+    } catch {
+      /* ignore */
+    }
+  };
+
+  // From already-extracted candidates that are still "unknown" same-site pages
+  for (const c of candidates) {
+    if (c.kind === "unknown" || c.kind === "github-repo") {
+      consider(c.url, c.score);
+    }
+  }
+
+  // Also scan HTML for product-ish anchors
+  const hrefRe = /\bhref\s*=\s*["']([^"']+)["']/gi;
+  let m: RegExpExecArray | null;
+  while ((m = hrefRe.exec(html)) !== null) {
+    const href = m[1];
+    if (/\/(apps?|download)\b/i.test(href) || (preferred && href.toLowerCase().includes(preferred))) {
+      consider(href, 25);
+    }
+  }
+
+  const ordered = [...hops.entries()]
+    .map(([url, score]) => ({ url, score }))
+    .sort((a, b) => b.score - a.score)
+    .filter((h) => h.score >= 25)
+    .slice(0, maxPages);
+
+  if (!ordered.length) return candidates;
+
+  let fetchHtml = opts.fetchHtml;
+  if (!fetchHtml) {
+    fetchHtml = async (url: string) => {
+      const fetched = await fetchTextLimited(url);
+      return { body: fetched.body, url: fetched.url };
+    };
+  }
+
+  const extras: DiscoverCandidate[] = [];
+  for (const hop of ordered) {
+    try {
+      log(`product-page hop → ${hop.url} (score ${hop.score})`);
+      const page = await fetchHtml(hop.url);
+      const pageCands = extractCandidatesFromHtml(page.body, page.url || hop.url).map((c) => ({
+        ...c,
+        evidence: [...c.evidence, "product-page-hop", hop.url],
+        score: c.score + (preferred && c.url.toLowerCase().includes(preferred) ? 15 : 0),
+      }));
+      extras.push(...pageCands);
+    } catch (err: any) {
+      log(`product hop ${hop.url}: ${err?.message || err}`);
+    }
+  }
+
+  if (!extras.length) return candidates;
+  return mergeCandidates(candidates, extras);
+}
