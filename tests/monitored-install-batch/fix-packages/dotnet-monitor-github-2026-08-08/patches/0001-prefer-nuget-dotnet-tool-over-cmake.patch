+/** Root-file markers that indicate a .NET/SDK-style repository. */
+export function hasDotnetProjectMarkers(fileNames: string[] = []): boolean {
+  if (!fileNames?.length) return false;
+  const names = new Set(fileNames.map((f) => String(f).toLowerCase()));
+  const hasSln = fileNames.some((f) => /\.sln$/i.test(String(f)));
+  return (
+    hasSln ||
+    names.has("global.json") ||
+    names.has("directory.build.props") ||
+    names.has("nuget.config")
+  );
+}
