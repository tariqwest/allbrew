+/**
+ * Resolve same-site /download/apple-silicon style links to real cask artifacts.
+ */
+export async function enrichPlatformDownloadRedirects(
+  candidates: DiscoverCandidate[],
+  pageUrl: string,
+  opts: {
+    log?: (msg: string) => void;
+    maxResolve?: number;
+    resolve?: typeof resolveRedirectArtifact;
+  } = {},
+): Promise<DiscoverCandidate[]> {
+  const log = opts.log || (() => {});
+  const maxResolve = opts.maxResolve ?? 6;
+  const resolve = opts.resolve || resolveRedirectArtifact;
+  const extras: DiscoverCandidate[] = [];
+  const queue: DiscoverCandidate[] = [];
+  for (const c of candidates) {
+    if (isMacPlatformDownloadPath(c.url)) queue.push(c);
+    else if (
+      /\/(?:download|downloads)\//i.test(c.url) &&
+      /apple[-_]?silicon|apple[-_]?intel|mac(?:os)?|darwin|arm64|aarch64|intel|universal/i.test(
+        c.url,
+      ) &&
+      !/\.(dmg|pkg|zip|exe|deb|rpm|AppImage)(?:\?|#|$)/i.test(c.url)
+    ) {
+      queue.push(c);
+    }
+  }
+  // Prefer arm64 / apple-silicon first on Apple Silicon hosts
+  queue.sort((a, b) => {
+    const score = (u: string) => {
+      let s = 0;
+      if (/apple[-_]?silicon|arm64|aarch64/i.test(u)) s += 10;
+      if (/apple[-_]?intel|x86_64|x64|intel/i.test(u)) s += 5;
+      if (/windows|linux|\.deb/i.test(u)) s -= 20;
+      return s;
+    };
+    return score(b.url) - score(a.url);
+  });
+  const seen = new Set<string>();
+  let n = 0;
+  for (const c of queue) {
+    if (n >= maxResolve) break;
+    if (seen.has(c.url)) continue;
+    seen.add(c.url);
+    n++;
+    try {
+      const resolved = await resolve(c.url);
+      if (!resolved?.looksLikeMacApp) continue;
+      const artifactUrl = resolved.finalUrl;
+      const scored = scoreCandidateUrl(artifactUrl, pageUrl, [
+        "platform-download-redirect",
+        `from:${c.url}`,
+      ]);
+      // Force cask-dmg when disposition/path says so
+      if (
+        resolved.filename &&
+        /\.(dmg|pkg)$/i.test(resolved.filename)
+      ) {
+        scored.kind = "cask-dmg";
+        scored.score = Math.max(scored.score, 130);
+        scored.evidence.push(`content-disposition:${resolved.filename}`);
+      } else if (/\.(dmg|pkg)(?:\?|#|$)/i.test(artifactUrl)) {
+        scored.kind = "cask-dmg";
+        scored.score = Math.max(scored.score, 125);
+      } else {
+        scored.kind = "cask-dmg";
+        scored.score = Math.max(scored.score, 120);
+        scored.evidence.push("cdn-platform-artifact");
+      }
+      if (/apple[-_]?silicon|arm64|aarch64|dmg-aarch64/i.test(c.url + artifactUrl)) {
+        scored.score += 8;
+        scored.evidence.push("arm64-hint");
+      }
+      extras.push(scored);
+      log(`platform download redirect: ${c.url} → ${artifactUrl}`);
+    } catch (err: any) {
+      log(`platform redirect ${c.url}: ${err?.message || err}`);
+    }
+  }
+  if (!extras.length) return candidates;
+  return mergeCandidates(candidates, extras);
+}
