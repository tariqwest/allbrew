+/** Marketing download hub paths that redirect to DMG/PKG (no file extension). */
+const MAC_PLATFORM_DOWNLOAD_PATH_RE =
+  /\/(?:download|downloads|get)(?:\/(?:mac(?:os)?|darwin|osx|apple[-_]?silicon|apple[-_]?intel|arm64|aarch64|universal|intel|x64|x86_64|dmg))?\/?$/i;
+
+const PLATFORM_DOWNLOAD_SEGMENT_RE =
+  /\/(?:download|downloads|get)\/(?:mac(?:os)?|darwin|osx|apple[-_]?silicon|apple[-_]?intel|arm64|aarch64|universal|intel|x64|x86_64|dmg)(?:\/|$|\?)/i;
+
+export function isMacPlatformDownloadPath(url: string): boolean {
+  try {
+    const u = new URL(url);
+    const path = u.pathname;
+    if (PLATFORM_DOWNLOAD_SEGMENT_RE.test(path)) return true;
+    // /download alone is a hub, not a direct artifact — still useful as soft signal elsewhere
+    if (/\/(?:download|downloads)\/(?:apple[-_]?silicon|apple[-_]?intel|mac(?:os)?|darwin)/i.test(path)) {
+      return true;
+    }
+    return false;
+  } catch {
+    return false;
+  }
+}
+
+function filenameFromContentDisposition(header: string | null): string | null {
+  if (!header) return null;
+  const star = /filename\*=(?:UTF-8''|utf-8'')([^;]+)/i.exec(header);
+  if (star?.[1]) {
+    try {
+      return decodeURIComponent(star[1].trim().replace(/^["']|["']$/g, ""));
+    } catch {
+      return star[1].trim().replace(/^["']|["']$/g, "");
+    }
+  }
+  const plain = /filename\s*=\s*("?)([^";]+)\1/i.exec(header);
+  return plain?.[2]?.trim() || null;
+}
