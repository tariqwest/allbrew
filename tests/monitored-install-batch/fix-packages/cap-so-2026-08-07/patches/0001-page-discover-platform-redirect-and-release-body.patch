+/**
+ * HEAD/GET redirect chain for platform download pages; promote CDN targets with
+ * Content-Disposition .dmg/.pkg (e.g. Cap → crabnebula CDN asset IDs).
+ */
+export async function resolveRedirectArtifact(
+  startUrl: string,
+  opts: { timeoutMs?: number; maxRedirects?: number } = {},
+): Promise<{
+  finalUrl: string;
+  filename: string | null;
+  contentType: string;
+  looksLikeMacApp: boolean;
+} | null> {
+  const timeoutMs = opts.timeoutMs ?? 15_000;
+  const maxRedirects = opts.maxRedirects ?? 8;
+  let current = startUrl;
+  try {
+    for (let i = 0; i <= maxRedirects; i++) {
+      assertSafePublicFetchUrl(current);
+      const controller = new AbortController();
+      const timer = setTimeout(() => controller.abort(), timeoutMs);
+      try {
+        let response = await fetch(current, {
+          method: "HEAD",
+          redirect: "manual",
+          headers: { "User-Agent": "allbrew/1.0", Accept: "*/*" },
+          signal: controller.signal,
+        });
+        // Some CDNs reject HEAD
+        if (response.status === 405 || response.status === 501) {
+          response = await fetch(current, {
+            method: "GET",
+            redirect: "manual",
+            headers: {
+              "User-Agent": "allbrew/1.0",
+              Accept: "*/*",
+              Range: "bytes=0-0",
+            },
+            signal: controller.signal,
+          });
+        }
+        if ([301, 302, 303, 307, 308].includes(response.status)) {
+          const location = response.headers.get("location");
+          if (!location) return null;
+          current = new URL(location, current).href;
+          continue;
+        }
+        if (!response.ok && response.status !== 206) return null;
+        const contentType = (response.headers.get("content-type") || "").toLowerCase();
+        const filename = filenameFromContentDisposition(
+          response.headers.get("content-disposition"),
+        );
+        const dispDmg = Boolean(filename && /\.(dmg|pkg)$/i.test(filename));
+        const pathDmg = /\.(dmg|pkg)(?:\?|#|$)/i.test(current);
+        const platformHint =
+          /dmg[-_]|publicPlatform=dmg|apple[-_]?silicon|apple[-_]?intel|darwin|macos/i.test(
+            current,
+          );
+        const binaryType =
+          /octet-stream|binary|dmg|x-apple|diskimage|zip/i.test(contentType) &&
+          !/text\/html|application\/json|javascript/i.test(contentType);
+        const looksLikeMacApp = dispDmg || pathDmg || (platformHint && binaryType) ||
+          (platformHint && /cdn\.|crabnebula|r2\.|cloudfront|amazonaws/i.test(current));
+        if (!looksLikeMacApp && !dispDmg && !pathDmg) return null;
+        return {
+          finalUrl: current,
+          filename,
+          contentType,
+          looksLikeMacApp: true,
+        };
+      } finally {
+        clearTimeout(timer);
+      }
+    }
+  } catch {
+    return null;
+  }
+  return null;
+}
