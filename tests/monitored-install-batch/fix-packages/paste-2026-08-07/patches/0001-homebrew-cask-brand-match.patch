+function registrableHost(hostname: string): string {
+  const parts = String(hostname || "")
+    .toLowerCase()
+    .split(".")
+    .filter(Boolean);
+  if (parts.length <= 2) return parts.join(".");
+  return parts.slice(-2).join(".");
+}
+
+/** First DNS label of a hostname (www stripped), e.g. paste.app → paste. */
+export function hostBrandLabel(hostname: string): string {
+  const host = String(hostname || "")
+    .toLowerCase()
+    .replace(/^www\./, "");
+  return host.split(".")[0] || "";
+}
+
+/**
+ * Brand-compatible when page domain and cask homepage share a product brand
+ * with the cask token — not only exact registrable-domain equality.
+ * Examples that should match:
+ *   paste.app + token paste + homepage pasteapp.io
+ * Unrelated domains with an explicit --name still refuse (example.com + paste).
+ */
+export function brandsCompatible(
+  pageBrand: string,
+  caskBrand: string,
+  token: string,
+): boolean {
+  const pb = String(pageBrand || "").toLowerCase();
+  const cb = String(caskBrand || "").toLowerCase();
+  const t = String(token || "").toLowerCase();
+  if (!pb || !cb || !t || t.length < 3) return false;
+  if (pb === cb) return true;
+  // page brand is exactly the token and cask brand is token or token-prefixed
+  // (paste + pasteapp)
+  if (pb === t && (cb === t || cb.startsWith(t))) return true;
+  // both brands start with the token
+  if (pb.startsWith(t) && cb.startsWith(t)) return true;
+  return false;
+}
