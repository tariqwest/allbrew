+/** Common marketing-site TLD swaps when the assigned host is wrong or parked. */
+const ALT_TLDS = ["com", "app", "io", "dev", "co", "net", "org", "sh", "so"] as const;
+
+/**
+ * Build alternate homepage URLs by swapping the public suffix for a single-label host.
+ * e.g. https://recordly.app → https://recordly.dev (catalog often uses wrong TLD).
+ * Returns [] for multi-label hosts (foo.bar.com) or IPs.
+ */
+export function alternateTldUrls(pageUrl: string): string[] {
+  let u: URL;
+  try {
+    u = new URL(pageUrl);
+  } catch {
+    return [];
+  }
+  const host = u.hostname.toLowerCase().replace(/^www\./, "");
+  const parts = host.split(".");
+  // only brand.tld (optional www) — not sub.domain.tld
+  if (parts.length !== 2) return [];
+  const [label, tld] = parts;
+  if (!label || !/^[a-z0-9-]+$/i.test(label)) return [];
+  if (/^\d+$/.test(label)) return [];
+
+  const out: string[] = [];
+  for (const alt of ALT_TLDS) {
+    if (alt === tld) continue;
+    const nu = new URL(u.toString());
+    nu.hostname = label + "." + alt;
+    out.push(nu.toString());
+  }
+  return out;
+}
+
+function isDnsOrHostLookupError(err: unknown): boolean {
+  const msg = String((err as any)?.message || err || "").toLowerCase();
+  const code = String((err as any)?.code || "").toUpperCase();
+  if (code === "ENOTFOUND" || code === "EAI_AGAIN" || code === "EHOSTUNREACH") return true;
+  return (
+    msg.includes("enotfound") ||
+    msg.includes("getaddrinfo") ||
+    msg.includes("nodename nor servname") ||
+    msg.includes("name or service not known") ||
+    msg.includes("typo in the url") ||
+    msg.includes("could not resolve") ||
+    msg.includes("failed to lookup")
+  );
+}
+
+/** Detect domain-for-sale / parking pages that resolve but have no real product. */
+export function looksLikeParkedOrForSale(
+  html: string,
+  finalPageUrl: string,
+  candidates: DiscoverCandidate[] = [],
+): boolean {
+  const hay = `${html}\n${finalPageUrl}`.toLowerCase();
+  if (
+    /forsale\.godaddy\.com/.test(hay) ||
+    /godaddy\.com\/forsale\//.test(hay) ||
+    /hugedomains\.com/.test(hay) ||
+    /sedo\.com/.test(hay) ||
+    /dan\.com\/buy-domain/.test(hay) ||
+    /parkingcrew\.net/.test(hay) ||
+    /this domain (is|may be) for sale/.test(hay) ||
+    /domain is for sale/.test(hay) ||
+    /buy this domain/.test(hay)
+  ) {
+    return true;
+  }
+  // WebView often surfaces only same-site lander + forsale navigations
+  const hosts = candidates
+    .map((c) => {
+      try {
+        return new URL(c.url).hostname.toLowerCase();
+      } catch {
+        return "";
+      }
+    })
+    .filter(Boolean);
+  if (hosts.some((h) => h.includes("forsale.godaddy.com") || h.includes("hugedomains.com"))) {
+    return true;
+  }
+  return false;
+}
+
+function hasStrongDownloadCandidate(chosen: DiscoverCandidate | null | undefined): boolean {
+  return Boolean(chosen && chosen.score >= 70 && chosen.kind !== "unknown");
+}
