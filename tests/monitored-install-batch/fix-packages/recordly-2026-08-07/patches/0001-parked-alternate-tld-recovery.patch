+      ]),
+    ).toBe(true);
+  });
+
+  it("does not flag real product pages", () => {
+    expect(
+      looksLikeParkedOrForSale(
+        "<html><body><a href='/download'>Get Recordly</a></body></html>",
+        "https://recordly.dev/",
+      ),
+    ).toBe(false);
+  });
+});
