+describe("alternateTldUrls", () => {
+  it("swaps brand.tld marketing hosts (.app → .dev/.com)", () => {
+    const alts = alternateTldUrls("https://recordly.app/");
+    expect(alts).toContain("https://recordly.dev/");
+    expect(alts).toContain("https://recordly.com/");
+    expect(alts.every((u) => !u.includes("recordly.app"))).toBe(true);
+  });
+
+  it("preserves path and query on alternate hosts", () => {
+    const alts = alternateTldUrls("https://foo.app/download?x=1");
+    const com = alts.find((u) => u.includes("foo.com"));
+    expect(com).toBe("https://foo.com/download?x=1");
+  });
+
+  it("skips multi-label hosts (subdomains)", () => {
+    expect(alternateTldUrls("https://download.recordly.com/x")).toEqual([]);
+    expect(alternateTldUrls("https://docs.example.io/guide")).toEqual([]);
+  });
+});
+
+describe("looksLikeParkedOrForSale", () => {
+  it("detects GoDaddy for-sale redirects", () => {
+    expect(
+      looksLikeParkedOrForSale(
+        '<script>location="https://forsale.godaddy.com/forsale/recordly.app"</script>',
+        "https://recordly.app/",
+      ),
+    ).toBe(true);
+  });
+
+  it("detects forsale candidates from webview", () => {
+    expect(
+      looksLikeParkedOrForSale("", "https://recordly.app/", [
+        {
+          url: "https://forsale.godaddy.com/forsale/recordly.app",
+          kind: "unknown",
+          score: 10,
+          evidence: ["navigated"],
+          source: "webview",
