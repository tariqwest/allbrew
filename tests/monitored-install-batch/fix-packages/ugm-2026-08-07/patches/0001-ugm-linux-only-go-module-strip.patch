+        (t) =>
+          // Relative/absolute paths and filenames (slides.md, dir/, ./foo)
+          /[\/]/.test(t) ||
+          /^\.{1,2}(?:\/|$)/.test(t) ||
+          /\.(?:md|markdown|html?|pdf|txt|adoc|rst|tex|json|ya?ml|toml)$/i.test(
+            t,
+          ),
+      )
