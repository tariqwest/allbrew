+/**
+ * Pure npmjs URLs skip the GitHub README path, so service detection never runs.
+ * Pull registry metadata + linked GitHub README (when present) so daemons like
+ * verdaccio get a `service do` block under non-interactive install.
+ */
+async function resolveNpmServiceConfig(packageName) {
+  try {
+    const registryBase =
+      process.env.NPM_REGISTRY_URL || "https://registry.npmjs.org";
+    const registryUrl = `${registryBase}/${encodeURIComponent(packageName)}`;
+    const response = await fetch(registryUrl, {
+      headers: { Accept: "application/json", "User-Agent": "allbrew/1.0" },
+    });
+    if (!response.ok) return null;
+
+    const pkgData = await response.json();
+    const latest = pkgData["dist-tags"]?.latest;
+    const versionData = latest ? pkgData.versions?.[latest] : null;
+    const repoField =
+      versionData?.repository || pkgData.repository || null;
+    let repoUrl =
+      typeof repoField === "string" ? repoField : repoField?.url || "";
+    repoUrl = String(repoUrl)
+      .replace(/^git\+/, "")
+      .replace(/^git:\/\//, "https://")
+      .replace(/\.git$/, "");
+
+    const gh =
+      repoUrl.match(
+        /(?:github\.com[:/]|github:)([^/\s]+)\/([^/\s#?]+)/i,
+      ) || null;
+
+    let readmeText = "";
+    if (gh) {
+      const owner = gh[1];
+      const repo = gh[2].replace(/\.git$/, "");
+      try {
+        const readme = await getReadme(owner, repo);
+        if (readme) readmeText = readme;
+      } catch {
+        /* optional */
+      }
+    }
+
+    // Fall back to registry description + keywords when README is missing.
+    if (!readmeText) {
+      const desc =
+        pkgData.description || versionData?.description || "";
+      const keywords = Array.isArray(pkgData.keywords)
+        ? pkgData.keywords.join(" ")
+        : Array.isArray(versionData?.keywords)
+          ? versionData.keywords.join(" ")
+          : "";
+      const binKeys =
+        versionData?.bin && typeof versionData.bin === "object"
+          ? Object.keys(versionData.bin).join(" ")
+          : packageName;
+      readmeText = [desc, keywords, binKeys, packageName]
+        .filter(Boolean)
+        .join("\n");
+    }
+
+    return detectServiceConfig(readmeText, packageName);
+  } catch {
+    return null;
+  }
+}
+
 async function handleNpmPackage(classification, opts) {
   const packageName = opts.package || classification.packageName;
   if (!packageName) {
     throw new Error("npm package name required (use --package or an npmjs URL)");
   }
+  let serviceConfig = null;
+  if (opts.service !== false && !opts.serviceCommand) {
+    const spinner = ora(
+      "Detecting service config from npm metadata/README...",
+    ).start();
+    serviceConfig = await resolveNpmServiceConfig(packageName);
+    if (serviceConfig) {
+      spinner.succeed(
+        `Detected service/launchagent hint${
+          serviceConfig.confidence
+            ? ` (${serviceConfig.confidence} confidence)`
+            : ""
+        }`,
+      );
+    } else {
+      spinner.stop();
+    }
+  }
   return await generateWithConfirmation(
     "npm-package",
-    { packageName, repoInfo: null },
+    { packageName, repoInfo: null, serviceConfig },
     opts,
   );
 }
