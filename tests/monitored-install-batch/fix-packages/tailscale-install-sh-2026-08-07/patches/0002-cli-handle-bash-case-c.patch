 async function handleBashScript(url, opts) {
+  // Vendor install scripts often are App Store openers or distro PM drivers
+  // (e.g. https://tailscale.com/install.sh). Prefer Case C official Homebrew
+  // packages over minting an Empty-installation PREFIX formula.
+  let body = "";
+  try {
+    const res = await fetch(url, {
+      headers: { "User-Agent": "allbrew/1.0" },
+      signal: AbortSignal.timeout(30_000),
+      redirect: "follow",
+    });
+    if (res.ok) body = await res.text();
+  } catch {
+    /* fall through to generator */
+  }
+
+  if (body) {
+    const { analyzeInstallScript } = await import("./install-script-analyze.ts");
+    const analysis = analyzeInstallScript(url, body);
+    if (
+      analysis.kind === "appstore-macos-only" ||
+      analysis.kind === "system-wide-out-of-scope"
+    ) {
+      const nameCandidates = [
+        opts.name,
+        opts.package,
+        analysis.packageHint,
+      ].filter(Boolean);
+      for (const candidate of nameCandidates) {
+        const brewHit = resolveExistingHomebrewClassification(String(candidate));
+        if (brewHit) {
+          console.log(
+            chalk.yellow(
+              `  Install script is not Cellar-PREFIX compatible (${analysis.kind}); ` +
+                `using existing Homebrew ${
+                  brewHit.type === "homebrew-formula" ? "formula" : "cask"
+                } "${brewHit.name}" (Case C)`,
+            ),
+          );
+          opts = {
+            ...opts,
+            name: opts.name || brewHit.name,
+            sourceUrl: url,
+            discoverMethod: "install-script-case-c",
+          };
+          return await dispatchClassification(brewHit, opts);
+        }
+      }
+
+      // MAS fallback when script only opens App Store and no core/cask hit
+      if (analysis.kind === "appstore-macos-only" && analysis.appStoreId) {
+        const masUrl = `https://apps.apple.com/app/id${analysis.appStoreId}`;
+        console.log(
+          chalk.yellow(
+            `  Install script opens Mac App Store; generating MAS cask for id${analysis.appStoreId}`,
+          ),
+        );
+        return await handleMacAppStore(masUrl, {
+          ...opts,
+          sourceUrl: url,
+          discoverMethod: "install-script-appstore",
+        });
+      }
+
+      throw new Error(
+        analysis.reason ||
+          `Install script at ${url} cannot be packaged as a Homebrew PREFIX install-script`,
+      );
+    }
+  }
+
   return await generateWithConfirmation("install-script", { url }, opts);
 }
 
