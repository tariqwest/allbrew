diff --git a/tests/unit/install-script-analyze-tailscale.test.ts b/tests/unit/install-script-analyze-tailscale.test.ts
new file mode 100644
index 0000000..587f4b1
--- /dev/null
+++ b/tests/unit/install-script-analyze-tailscale.test.ts
@@ -0,0 +1,101 @@
+import { describe, expect, it } from "bun:test";
+import {
+  analyzeInstallScript,
+  packageHintFromInstallUrl,
+} from "../../lib/install-script-analyze.ts";
+import { formatBottleCellar } from "../../lib/generators/homebrew-formula.ts";
+import {
+  resolveExistingHomebrewClassification,
+  setHomebrewCorePrefixForTests,
+  setHomebrewCaskTokenOverrideForTests,
+} from "../../lib/utils.ts";
+import { mkdirSync, writeFileSync, rmSync } from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+
+const TAILSCALE_INSTALL_SNIPPET = `#!/bin/sh
+# Copyright (c) Tailscale Inc
+main() {
+OS=""
+PACKAGETYPE=""
+case "$(uname -s)" in
+Darwin)
+OS="macos"
+PACKAGETYPE="appstore"
+;;
+esac
+case "$PACKAGETYPE" in
+appstore)
+set -x
+open "https://apps.apple.com/us/app/tailscale/id1475387142"
+set +x
+;;
+apt)
+$SUDO apt-get install -y tailscale
+;;
+esac
+}
+main
+`;
+
+describe("packageHintFromInstallUrl", () => {
+  it("derives tailscale from tailscale.com/install.sh", () => {
+    expect(packageHintFromInstallUrl("https://tailscale.com/install.sh")).toBe(
+      "tailscale",
+    );
+  });
+});
+
+describe("analyzeInstallScript tailscale", () => {
+  it("flags App Store-only macOS vendor installer", () => {
+    const a = analyzeInstallScript(
+      "https://tailscale.com/install.sh",
+      TAILSCALE_INSTALL_SNIPPET,
+    );
+    expect(a.kind).toBe("appstore-macos-only");
+    expect(a.appStoreId).toBe("1475387142");
+    expect(a.packageHint).toBe("tailscale");
+    expect(a.signals.length).toBeGreaterThan(0);
+  });
+
+  it("prefix-ok when script honors PREFIX", () => {
+    const a = analyzeInstallScript(
+      "https://example.com/install.sh",
+      `#!/bin/sh\nPREFIX=\${PREFIX:-/usr/local}\nmkdir -p "$PREFIX/bin"\ncp foo "$PREFIX/bin/"\n`,
+    );
+    expect(a.kind).toBe("prefix-ok");
+  });
+});
+
+describe("formatBottleCellar", () => {
+  it("does not double-colon API symbol strings", () => {
+    expect(formatBottleCellar(":any_skip_relocation")).toBe(
+      ":any_skip_relocation",
+    );
+    expect(formatBottleCellar("any_skip_relocation")).toBe(
+      ":any_skip_relocation",
+    );
+    expect(formatBottleCellar("/opt/homebrew/Cellar")).toBe(
+      JSON.stringify("/opt/homebrew/Cellar"),
+    );
+  });
+});
+
+describe("resolveExistingHomebrewClassification", () => {
+  it("prefers core formula when present", () => {
+    const root = join(tmpdir(), `allbrew-core-${Date.now()}`);
+    mkdirSync(join(root, "Formula", "t"), { recursive: true });
+    writeFileSync(join(root, "Formula", "t", "tailscale.rb"), "class Tailscale\n");
+    setHomebrewCorePrefixForTests(root);
+    setHomebrewCaskTokenOverrideForTests(null);
+    try {
+      const hit = resolveExistingHomebrewClassification("tailscale");
+      expect(hit?.type).toBe("homebrew-formula");
+      expect(hit?.name).toBe("tailscale");
+    } finally {
+      setHomebrewCorePrefixForTests(undefined);
+      setHomebrewCaskTokenOverrideForTests(undefined);
+      rmSync(root, { recursive: true, force: true });
+    }
+  });
+});
