+/**
+ * Client/management CLI subcommands for hubs (login, servers list, tools call).
+ * These must never become `service do` run argv.
+ */
+function isOneShotPackageCliCommand(command, packageName) {
+  if (!command || !packageName) return false;
+  const parts = String(command).trim().split(/\s+/).filter(Boolean);
+  if (parts.length < 2) return false;
+  const executable = parts[0].split("/").pop();
+  if (executable !== packageName) return false;
+  return ONE_SHOT_PACKAGE_CLI_SUBCOMMANDS.has(parts[1].toLowerCase());
+}
