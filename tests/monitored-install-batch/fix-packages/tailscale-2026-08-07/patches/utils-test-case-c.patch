+describe("resolveExistingHomebrewClassification", () => {
+  let coreRoot: string;
+  let caskRoot: string;
+
+  beforeEach(() => {
+    coreRoot = mkdtempSync(join(tmpdir(), "allbrew-core-"));
+    caskRoot = mkdtempSync(join(tmpdir(), "allbrew-cask-hb-"));
+    mkdirSync(join(coreRoot, "Formula", "t"), { recursive: true });
+    writeFileSync(
+      join(coreRoot, "Formula", "t", "tailscale.rb"),
+      "class Tailscale < Formula\nend\n",
+    );
+    mkdirSync(join(caskRoot, "Casks", "t"), { recursive: true });
+    writeFileSync(
+      join(caskRoot, "Casks", "t", "tailscale-app.rb"),
+      'cask "tailscale-app" do\nend\n',
+    );
+    setHomebrewCorePrefixForTests(coreRoot);
+    setHomebrewCaskPrefixForTests(caskRoot);
+    setHomebrewCaskTokenOverrideForTests(undefined);
+  });
+
+  afterEach(() => {
+    setHomebrewCorePrefixForTests(undefined);
+    setHomebrewCaskPrefixForTests(undefined);
+    setHomebrewCaskTokenOverrideForTests(undefined);
+    rmSync(coreRoot, { recursive: true, force: true });
+    rmSync(caskRoot, { recursive: true, force: true });
+  });
+
+  it("maps bare tailscale name to homebrew/core formula (Case C)", () => {
+    const hit = resolveExistingHomebrewClassification("tailscale");
+    expect(hit).toEqual({
+      type: "homebrew-formula",
+      name: "tailscale",
+      url: "https://formulae.brew.sh/formula/tailscale",
+    });
+  });
+
+  it("maps cask-only token to homebrew-cask", () => {
+    const hit = resolveExistingHomebrewClassification("tailscale-app");
+    expect(hit).toEqual({
+      type: "homebrew-cask",
+      name: "tailscale-app",
+      url: "https://formulae.brew.sh/cask/tailscale-app",
+    });
+  });
+
+  it("returns null for unknown names", () => {
+    expect(resolveExistingHomebrewClassification("not-a-real-package-xyz")).toBe(
+      null,
+    );
+    expect(resolveExistingHomebrewClassification("")).toBe(null);
+    expect(resolveExistingHomebrewClassification(null)).toBe(null);
+  });
+});
