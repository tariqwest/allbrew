+/**
+ * Case C short-circuit: when a product homepage/unknown URL is paired with a
+ * name that already exists in homebrew/core or homebrew/cask, prefer adopting
+ * the official package instead of minting a tap duplicate or failing discovery.
+ * Prefer formula when both exist for the same bare token (CLI path).
+ */
+export function resolveExistingHomebrewClassification(
+  name: string | null | undefined,
+): { type: "homebrew-formula" | "homebrew-cask"; name: string; url: string } | null {
+  const raw = String(name || "").trim();
+  if (!raw) return null;
+
+  const formulaName = toFormulaName(raw);
+  if (formulaName && isHomebrewCoreFormulaName(formulaName)) {
+    return {
+      type: "homebrew-formula",
+      name: formulaName,
+      url: `https://formulae.brew.sh/formula/${formulaName}`,
+    };
+  }
+
+  const caskToken = toCaskToken(raw);
+  if (caskToken && isHomebrewCaskToken(caskToken)) {
+    return {
+      type: "homebrew-cask",
+      name: caskToken,
+      url: `https://formulae.brew.sh/cask/${caskToken}`,
+    };
+  }
+
+  return null;
+}
