+async function handleCargoPackage(classification, opts) {
+  const crateName = opts.crateName || classification.crateName || opts.package;
+  if (!crateName) {
+    throw new Error(
+      "crates.io crate name required (use --crate-name or a crates.io URL)",
+    );
+  }
+  const { fetchCratesIoCrate, repoInfoFromCratesMeta } = await import(
+    "./generators/cargo-package.ts"
+  );
+  const spinner = ora(`Fetching crates.io metadata for ${crateName}...`).start();
+  let cratesMeta;
+  try {
+    cratesMeta = await fetchCratesIoCrate(crateName);
+    spinner.succeed(
+      `crates.io: ${chalk.cyan(cratesMeta.crateName)}@${chalk.cyan(cratesMeta.version)}`,
+    );
+  } catch (err) {
+    spinner.fail(`crates.io lookup failed: ${err.message}`);
+    throw err;
+  }
+  const repoInfo = repoInfoFromCratesMeta(cratesMeta);
+  return await generateWithConfirmation(
+    "cargo-package",
+    {
+      repoInfo,
+      release: null,
+      crateName: cratesMeta.crateName,
+      cratesMeta,
+    },
+    { ...opts, crateName: cratesMeta.crateName },
+  );
+}
+
+async function handleGoPackage(classification, opts) {
+  const goModule = opts.goModule || classification.goModule;
+  if (!goModule) {
+    throw new Error(
+      "Go module path required (use --go-module or a pkg.go.dev URL)",
+    );
+  }
+  const nameHint = goModule.split("/").pop() || "go-module";
+  const repoInfo = {
+    name: nameHint,
+    fullName: goModule.replace(/^github\.com\//, ""),
+    description: null,
+    homepage: `https://${goModule}`,
+    htmlUrl: goModule.startsWith("github.com/")
+      ? `https://${goModule}`
+      : `https://pkg.go.dev/${goModule}`,
+    defaultBranch: "main",
+    license: null,
+  };
+  return await generateWithConfirmation(
+    "go-package",
+    { repoInfo, release: null, goModule },
+    { ...opts, goModule },
+  );
+}
+
