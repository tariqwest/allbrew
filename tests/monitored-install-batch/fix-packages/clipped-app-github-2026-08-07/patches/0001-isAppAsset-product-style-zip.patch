@@ -606,6 +610,44 @@ export function isAppAsset(assetName) {
   return true;
 }
 
+/**
+ * PascalCase product zip without platform/arch tags (e.g. Clipped.zip, Raycast-1.0.zip).
+ * Lowercase hyphenated names like license-plist.zip stay CLI/portable binaries.
+ */
+function isProductStyleAppZip(assetName) {
+  if (!assetName || typeof assetName !== "string") return false;
+  if (!assetName.toLowerCase().endsWith(".zip")) return false;
+  const lower = assetName.toLowerCase();
+  if (
+    /(?:^|[^a-z])(?:linux|windows|win32|android|freebsd|openbsd)(?:[^a-z]|$)/i.test(
+      lower,
+    )
+  ) {
+    return false;
+  }
+  if (
+    /(?:^|[^a-z])(?:arm64|aarch64|amd64|x86_64|x64|i386|darwin|macos|osx|mac)(?:[^a-z]|$)/i.test(
+      lower,
+    )
+  ) {
+    return false;
+  }
+  if (
+    /(?:^|[^a-z])(?:source|src|portable|binary|binaries|checksums?)(?:[^a-z]|$)/i.test(
+      lower,
+    )
+  ) {
+    return false;
+  }
+  // Preserve case for PascalCase check; strip .zip
+  const base = assetName.slice(0, -4);
+  // Drop trailing version: -1.2.3, _v1.7.2, -1.0.0-beta
+  const stem = base.replace(/[-_]v?\d+(?:\.\d+)*(?:[-_][A-Za-z0-9]+)?$/i, "");
+  if (!stem) return false;
+  // Single PascalCase token (Clipped, MyApp) — not all-lowercase CLI names
+  return /^[A-Z][A-Za-z0-9]*$/.test(stem);
+}
