+
+/**
+ * Re-rank candidates for multi-mirror CDNs and optional preferred product name.
+ * Stable for equal scores: prefer -us mirrors, demote secondary product suffixes.
+ */
+export function rankCandidatesForPage(
+  candidates: DiscoverCandidate[],
+  opts: { preferredName?: string } = {},
+): DiscoverCandidate[] {
+  const preferred = (opts.preferredName || "")
+    .trim()
+    .toLowerCase()
+    .replace(/\.app$/i, "");
+  return candidates
+    .map((c) => {
+      let delta = 0;
+      const evidence = [...c.evidence];
+      const url = c.url;
+      const base = url.split("/").pop()?.split("?")[0] || "";
+      const baseLower = base.toLowerCase();
+
+      if (/-ai-us\//i.test(url) || /\/trae-ai-us\//i.test(url)) {
+        delta += 6;
+        evidence.push("cdn-region-us");
+      } else if (/-ai-sg\//i.test(url) || /\/trae-ai-sg\//i.test(url)) {
+        delta += 0;
+        evidence.push("cdn-region-sg");
+      } else if (/-ai-cn\//i.test(url) || /\.com\.cn\//i.test(url)) {
+        delta -= 6;
+        evidence.push("cdn-region-cn-penalty");
+      }
+
+      if (/TraeWork|trae-work/i.test(base) && preferred && preferred === "trae") {
+        delta -= 20;
+        evidence.push("secondary-product-penalty");
+      } else if (/Work(?:-|\.|$)/i.test(base) && preferred && !baseLower.includes(preferred + "work")) {
+        // e.g. FooWork when preferred is foo
+        if (baseLower.startsWith(preferred) && /work/i.test(baseLower)) {
+          delta -= 15;
+          evidence.push("secondary-product-penalty");
+        }
+      }
+
+      if (preferred) {
+        const stem = baseLower
+          .replace(/\.(dmg|pkg|zip|tar\.gz|tgz)$/i, "")
+          .replace(/-?(darwin|macOS|macos|osx|apple|silicon|arm64|aarch64|x64|x86_64|intel).*$/i, "");
+        if (stem === preferred || stem.startsWith(preferred + "-") || stem.startsWith(preferred + "_")) {
+          delta += 15;
+          evidence.push("preferred-name-match");
+        } else if (baseLower.includes(preferred) && !baseLower.includes(preferred + "work")) {
+          delta += 8;
+          evidence.push("preferred-name-partial");
+        }
+      }
+
+      if (delta === 0) return c;
+      return { ...c, score: c.score + delta, evidence: [...new Set(evidence)] };
+    })
+    .sort((a, b) => b.score - a.score || a.url.localeCompare(b.url));
+}
