+/**
+ * Rank competing release assets for the same arch.
+ * Prefer primary product archives (e.g. atuin-*-darwin.tar.gz, deno-*) over
+ * secondary tools (atuin-server, denort), libs, profile/android/musl, and deltas.
+ */
+export function scoreBinaryReleaseAsset(
+  assetName: string,
+  productHints: string[] = [],
+): number {
+  const lower = (assetName || "").toLowerCase();
+  let s = 0;
+
+  if (/\.(bsdiff|delta|patch)$/i.test(lower) || /\.from-\d/i.test(lower)) {
+    s -= 200;
+  }
+  if (/(?:^|[^a-z])android(?:[^a-z]|$)/i.test(lower)) s -= 100;
+  if (/(?:^|[^a-z])(?:profile|debug|symbols)(?:[^a-z]|$)/i.test(lower)) s -= 50;
+  if (/(?:^|[^a-z])baseline(?:[^a-z]|$)/i.test(lower)) s -= 20;
+  if (/(?:^|[^a-z])musl(?:[^a-z]|$)/i.test(lower)) s -= 10;
+  // Companion daemons / self-host servers shipped next to the main CLI.
+  if (/(?:^|[^a-z])(?:server|daemon)(?:[^a-z]|$)/i.test(lower)) s -= 60;
+
+  const base = lower.split("/").pop() || lower;
+  if (/^lib[a-z0-9]/i.test(base)) s -= 80;
+
+  const stem = base
+    .replace(/\.(tar\.gz|tgz|tar\.bz2|tar\.xz|zip|exe)$/i, "")
+    .replace(
+      /[-_.]?(darwin|macos|osx|linux|windows|win32|apple|unknown)[-_.]?(arm64|aarch64|amd64|x86_64|x64|i386|universal|gnu|musl)?/gi,
+      "",
+    )
+    .replace(/[-_.]?(arm64|aarch64|amd64|x86_64|x64|i386|universal)/gi, "")
+    .replace(/[-_.]+$/g, "");
+
+  const hints = productHints
+    .map((h) =>
+      String(h || "")
+        .toLowerCase()
+        .replace(/-tap\d*$/i, "")
+        .trim(),
+    )
+    .filter(Boolean);
+
+  for (const h of hints) {
+    if (stem === h) s += 100;
+    // Secondary tools that share a product prefix (atuin-server, denort)
+    else if (stem.startsWith(h) && stem.length > h.length) s -= 40;
+  }
+
+  if (isArchiveBinaryAsset(assetName)) s += 5;
+  s -= Math.min(stem.length, 20) * 0.01;
+
+  return s;
+}
