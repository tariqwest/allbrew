 async function handleBashScript(url, opts) {
+  // Pre-flight: reject system-wide installers (e.g. official Nix multi-user)
+  // that cannot land in the Cellar as PREFIX install-scripts.
+  try {
+    const { fetchTextLimited } = await import("./utils.ts");
+    const { assertInstallScriptInScope } = await import("./install-script-analyze.ts");
+    const fetched = await fetchTextLimited(url, { maxBytes: 512_000, timeoutMs: 30_000 });
+    assertInstallScriptInScope(fetched.url || url, fetched.body);
+  } catch (err: any) {
+    // Re-throw intentional out-of-scope / network errors from analyze
+    if (
+      err?.message?.includes("out of scope") ||
+      err?.message?.includes("system-wide") ||
+      err?.message?.includes("multi-user") ||
+      err?.message?.includes("Homebrew core also has no formula")
+    ) {
+      throw err;
+    }
+    // Soft-fail analysis on transient fetch issues; generator still hashes the URL.
+    if (opts?.verbose) {
+      console.log(`  install-script preflight skipped: ${err?.message || err}`);
+    }
+  }
   return await generateWithConfirmation("install-script", { url }, opts);
 }
 
