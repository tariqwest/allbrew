+class Pool < Formula
+  desc "Poolside AI coding agent CLI"
+  homepage "https://downloads.poolside.ai"
+  version "1.0.15"
+
+  on_macos do
+    on_arm do
+      url "https://downloads.poolside.ai/pool/v#{version}/pool-darwin-arm64.tar.gz"
+      sha256 "42d971d91611ed22cf2023f05bae53a4d746c015203923b392fe9b170ccb0b71"
+    end
+    on_intel do
+      url "https://downloads.poolside.ai/pool/v#{version}/pool-darwin-amd64.tar.gz"
+      sha256 "508490724fb63a7ff846e9d6f303d9ab9da875f0b18b26308d85cb03c8f43d6b"
+    end
+  end
+
+  on_linux do
+    on_arm do
+      url "https://downloads.poolside.ai/pool/v#{version}/pool-linux-arm64.tar.gz"
+      sha256 "df3ffd537d46943ae61513b7981df07bc5df79217fc5390b956d06bc81ac8198"
+    end
+    on_intel do
+      url "https://downloads.poolside.ai/pool/v#{version}/pool-linux-amd64.tar.gz"
+      sha256 "d7d7194bfe0e1e62fc3daa1b6ede8f2d4371691c663bed980eea4f5a7a659e08"
+    end
+  end
+
+  livecheck do
+    url "https://downloads.poolside.ai/pool/pool-latest-version.txt"
+    regex(/v?(\d+(?:\.\d+)+)/i)
+  end
+
+  def install
+    bin_path = Dir["*"].find { |f| File.file?(f) && File.executable?(f) }
+    bin_path ||= Dir["*"].find { |f| File.file?(f) && !f.end_with?(".txt", ".sha256", ".sig", ".asc", ".md") }
+    odie "No binary found in download" unless bin_path
+    bin.install bin_path => "pool"
+  end
+
+  test do
+    assert_match version.to_s, shell_output("#{bin}/pool --version")
+  end
+end
