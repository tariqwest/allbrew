+/** True when archive listing contains a macOS .app bundle path. */
+export function membersContainMacAppBundle(members: string[]): boolean {
+  return members.some((m) => {
+    const n = String(m || "").replace(/\\/g, "/");
+    return /(^|\/)[^/]+\.app(\/|$)/i.test(n);
+  });
+}
