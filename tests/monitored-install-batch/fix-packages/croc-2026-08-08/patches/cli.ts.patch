 async function handleBashScript(url, opts) {
+  // Many "curl | bash" portals Vary by User-Agent (HTML for browsers, script for curl).
+  // If the script is a thin GitHub-release downloader, prefer github-repo packaging so
+  // brew fetch uses stable release assets (Homebrew UA would otherwise get HTML).
+  try {
+    const res = await fetch(url, {
+      redirect: "follow",
+      headers: {
+        "User-Agent": "curl/8.4.0 allbrew/1.0",
+        Accept: "text/plain,*/*;q=0.8",
+      },
+      signal: AbortSignal.timeout(30_000),
+    });
+    if (res.ok) {
+      const ct = (res.headers.get("content-type") || "").toLowerCase();
+      if (!ct.includes("text/html")) {
+        const body = await res.text();
+        const gh = body.match(
+          /https?:\/\/github\.com\/([A-Za-z0-9_.-]+)\/([A-Za-z0-9_.-]+)\/releases(?:\/|\b)/,
+        );
+        if (gh) {
+          const owner = gh[1];
+          const repo = gh[2];
+          const repoUrl = `https://github.com/${owner}/${repo}`;
+          console.log(
+            `  Install script fetches GitHub releases for ${owner}/${repo} — packaging as github-repo`,
+          );
+          return await handleGithubRepo(
+            { type: "github-repo", url: repoUrl, owner, repo },
+            { ...opts, sourceUrl: opts.sourceUrl || url },
+          );
+        }
+      }
+    }
+  } catch {
+    /* fall through to install-script */
+  }
   return await generateWithConfirmation("install-script", { url }, opts);
 }
 
