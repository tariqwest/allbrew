@@ -410,6 +410,23 @@ describe("isAppAsset", () => {
     expect(isAppAsset("foo-linux-x64.zip")).toBe(false);
   });
 
+  it("matches versioned product zips without platform tags (macOS .app releases)", () => {
+    expect(isAppAsset("NetBar-1.2.1.zip")).toBe(true);
+    expect(isAppAsset("MyApp_2.0.0.zip")).toBe(true);
+    expect(isAppAsset("Foo-1.0.zip")).toBe(true);
+  });
+
+  it("rejects versioned zips that look like source or non-product archives", () => {
+    expect(isAppAsset("project-src-1.2.3.zip")).toBe(false);
+    expect(isAppAsset("sources-1.0.0.zip")).toBe(false);
+    expect(isAppAsset("foo.zip")).toBe(false);
+  });
+
+  it("matches short mac+arch desktop zips (Electron/Fyne)", () => {
+    expect(isAppAsset("Supersonic-0.22.0-mac-arm64.zip")).toBe(true);
+    expect(isAppAsset("Supersonic-0.22.0-mac-x64.zip")).toBe(true);
+  });
+
   it("rejects non-archive files", () => {
     expect(isAppAsset("README.md")).toBe(false);
   });
