+async function handleCargoPackage(classification, opts) {
+  const crateName =
+    opts.crateName || classification.crateName || opts.package;
+  if (!crateName) {
+    throw new Error(
+      "crates.io crate name required (use --crate-name or a crates.io URL)",
+    );
+  }
+
+  const { fetchCratesIoCrate } = await import("./generators/cargo-package.ts");
+  const spinner = ora(`Fetching crates.io metadata for ${crateName}...`).start();
+  let crateMeta: Awaited<ReturnType<typeof fetchCratesIoCrate>>;
+  try {
+    crateMeta = await fetchCratesIoCrate(crateName);
+    spinner.succeed(
+      `crates.io: ${chalk.bold(crateMeta.name)}@${crateMeta.version}` +
+        (crateMeta.binNames.length
+          ? ` (bin: ${crateMeta.binNames.join(", ")})`
+          : ""),
+    );
+  } catch (err: any) {
+    spinner.fail(`crates.io lookup failed: ${err?.message || err}`);
+    throw err;
+  }
+
+  let repoInfo: any = null;
+  if (crateMeta.githubOwner && crateMeta.githubRepo) {
+    try {
+      repoInfo = await getRepoInfo(crateMeta.githubOwner, crateMeta.githubRepo);
+    } catch {
+      repoInfo = null;
+    }
+  }
+  if (!repoInfo) {
+    repoInfo = {
+      name: crateMeta.name,
+      fullName:
+        crateMeta.githubOwner && crateMeta.githubRepo
+          ? `${crateMeta.githubOwner}/${crateMeta.githubRepo}`
+          : "",
+      description: crateMeta.description,
+      homepage: crateMeta.homepage,
+      htmlUrl:
+        crateMeta.repository || `https://crates.io/crates/${crateMeta.name}`,
+      defaultBranch: "main",
+      license: crateMeta.license,
+    };
+  }
+
+  const binName =
+    opts.binName ||
+    (crateMeta.binNames.length === 1 ? crateMeta.binNames[0] : undefined);
+
+  return await generateWithConfirmation(
+    "cargo-package",
+    {
+      repoInfo,
+      release: null,
+      crateName: crateMeta.name,
+      binName,
+      crateVersion: crateMeta.version,
+      crateChecksum: crateMeta.checksum,
+      desc: opts.desc || crateMeta.description,
+      license: crateMeta.license,
+      homepage: crateMeta.homepage,
+      githubOwner: crateMeta.githubOwner,
+      githubRepo: crateMeta.githubRepo,
+    },
+    opts,
+  );
+}
+
