+describe("detectGithubRepoRelocation", () => {
+  it("detects markdown-style moved-to full GitHub URL (Thaw stub)", () => {
+    const readme = "# Thaw\n\nThis repository has moved to: https://github.com/thaw-app/Thaw\n";
+    const r = detectGithubRepoRelocation(readme);
+    expect(r).not.toBeNull();
+    expect(r!.owner).toBe("thaw-app");
+    expect(r!.repo).toBe("Thaw");
+    expect(r!.url).toBe("https://github.com/thaw-app/Thaw");
+  });
+
+  it("detects owner/repo without URL", () => {
+    const readme = "This repository has moved to: acme/Widget\n";
+    const r = detectGithubRepoRelocation(readme);
+    expect(r).not.toBeNull();
+    expect(r!.owner).toBe("acme");
+    expect(r!.repo).toBe("Widget");
+  });
+
+  it("returns null when no relocation notice", () => {
+    expect(detectGithubRepoRelocation("## Install\n\nbrew install foo\n")).toBeNull();
+  });
+});
