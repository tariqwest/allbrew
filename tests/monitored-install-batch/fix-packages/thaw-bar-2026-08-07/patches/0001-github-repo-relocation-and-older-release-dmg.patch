+/**
+ * Detect README notes that the GitHub repository has moved to another owner/repo.
+ * Common patterns: "This repository has moved to: https://github.com/org/Name"
+ */
+export function detectGithubRepoRelocation(
+  readmeText: string,
+): { owner: string; repo: string; url: string } | null {
+  if (!readmeText) return null;
+  const text = String(readmeText);
+
+  const patterns = [
+    /(?:this\s+)?(?:repository|repo)\s+has\s+moved\s+to\s*:?\s*(?:\[[^\]]*\]\()?(https?:\/\/github\.com\/([A-Za-z0-9_.-]+)\/([A-Za-z0-9_.-]+))(?:\/)?(?:\))?/i,
+    /(?:moved|relocated)\s+to\s*:?\s*(?:\[[^\]]*\]\()?(https?:\/\/github\.com\/([A-Za-z0-9_.-]+)\/([A-Za-z0-9_.-]+))(?:\/)?(?:\))?/i,
+    /(?:new\s+(?:home|location|repository)|repo(?:sitory)?\s+(?:is\s+)?now\s+at)\s*:?\s*(?:\[[^\]]*\]\()?(https?:\/\/github\.com\/([A-Za-z0-9_.-]+)\/([A-Za-z0-9_.-]+))(?:\/)?(?:\))?/i,
+    /(?:this\s+)?(?:repository|repo)\s+has\s+moved\s+to\s*:?\s*([A-Za-z0-9_.-]+)\/([A-Za-z0-9_.-]+)\b/i,
+  ];
+
+  for (const re of patterns) {
+    const m = text.match(re);
+    if (!m) continue;
+    if (m[2] && m[3] && m[1]?.includes?.("github.com")) {
+      const owner = m[2];
+      const repo = String(m[3]).replace(/\.git$/i, "");
+      return { owner, repo, url: `https://github.com/${owner}/${repo}` };
+    }
+    if (m[1] && m[2] && !m[3]) {
+      const owner = m[1];
+      const repo = String(m[2]).replace(/\.git$/i, "");
+      if (/github\.com/i.test(owner)) continue;
+      return { owner, repo, url: `https://github.com/${owner}/${repo}` };
+    }
+  }
+  return null;
+}
