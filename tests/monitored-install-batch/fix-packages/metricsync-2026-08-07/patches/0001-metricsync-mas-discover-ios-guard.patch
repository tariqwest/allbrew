+/** Reject iPhone/iPad-only listings that cannot be installed via Homebrew `mas`. */
+export function assertMacAppStoreListing(metadata: any, appId: string): void {
+  const kind = String(metadata?.kind || "");
+  if (kind === "mac-software") return;
+
+  const devices: string[] = Array.isArray(metadata?.supportedDevices)
+    ? metadata.supportedDevices.map(String)
+    : [];
+  const onlyMobile =
+    devices.length > 0 &&
+    devices.every((d) => /iphone|ipad|ipod|watch|appletv|vision/i.test(d));
+
+  if (kind === "software" || onlyMobile) {
+    const name = metadata?.trackName || `id${appId}`;
+    throw new Error(
+      `App Store listing "${name}" (id${appId}) is not a Mac app` +
+        (kind ? ` (kind=${kind})` : "") +
+        "; Homebrew casks via mas only support Mac App Store software",
+    );
+  }
+  // Unknown kind with no device list: allow (older API shapes / universal apps).
+}
