{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "_comment": "Claude Code — GLOBAL template (~/.claude/settings.json) — warp-equivalent. Project variant: .claude/settings.json + .claude/settings.local.json (gitignored). Deny always wins over allow; allow grant only applies after workspace trust dialog.",
  "_source": "Generated from warp-agent-permissions.template.toml — bun/node/python3 + batch helpers + git + read-only tools allowed; rm/curl/scp/shells/sudo denied",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(bun:*)",
      "Bash(bun run:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(git:*)",
      "Bash(LUME_REMOTE_ENABLED=true bun tests/monitored-install-batch/*)",
      "Bash(bun tests/monitored-install-batch/*)",
      "Bash(node tests/monitored-install-batch/*)",
      "Bash(bun run bin/allbrew.ts:*)",
      "Bash(CI=1 ALLBREW_NONINTERACTIVE=1 bun run bin/allbrew.ts:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Bash(pwd:*)",
      "Bash(mktemp:*)",
      "Bash(mkdir:*)",
      "Bash(test:*)",
      "Bash(true)",
      "Bash(false)",
      "Bash(lume:*)",
      "Bash(ssh:*)",
      "Bash(brew:*)",
      "Read",
      "Glob",
      "Grep",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:registry.npmjs.org)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(zsh:*)",
      "Bash(fish:*)",
      "Bash(pwsh:*)",
      "Bash(eval:*)",
      "Bash(exec:*)",
      "Bash(source:*)",
      "Bash(wget:*)",
      "Bash(curl:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(telnet:*)",
      "Bash(dig:*)",
      "Bash(nslookup:*)",
      "Bash(host:*)",
      "Bash(sudo:*)"
    ],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[claude-permissions] PreToolUse Bash check — deny wins' >&2"
          }
        ]
      }
    ]
  }
}
